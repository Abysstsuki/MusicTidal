# Copy to .env.docker on the Ubuntu server and replace all three example secrets.
POSTGRES_DB=musictidal
POSTGRES_USER=music_user
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
NETEASE_COOKIE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional Netease credentials. Add only when these features need them.
# Rooms use the host's encrypted QR binding, never a global personal Cookie.
# NETEASE_ANONYMOUS_TOKEN=
# NETEASE_REAL_IP=

# Optional: host port used by Nginx. Backend remains bound to localhost.
BACKEND_PORT=3001
