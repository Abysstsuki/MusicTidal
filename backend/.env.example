# Required for MusicTidal user storage and authentication.
DATABASE_URL=
JWT_SECRET=
PORT=3001

# Optional: takes precedence over backend/cookie.txt.
NETEASE_COOKIE=

# Optional: takes precedence over backend/anonymous_token.
# Without a user/guest cookie or a configured token, a guest session is acquired in memory.
NETEASE_ANONYMOUS_TOKEN=

# Optional: uses the existing project default when empty.
NETEASE_REAL_IP=

# 64 hex characters; keep stable across deployments
NETEASE_COOKIE_ENCRYPTION_KEY=
